# Copy to server/.env and fill in. server/.env is git-ignored: never commit real values.

PORT=8787
HOST=127.0.0.1

# Solana (devnet only; never put a mainnet URL here)
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=
# Path to the backend signing key. The file itself must stay out of git.
OPERATOR_KEYPAIR_PATH=
# Comma-separated admin wallet addresses
ADMIN_WALLETS=

# Storage and sessions
DATABASE_URL=file:./prisma/dev.db
SESSION_SECRET=

# Heartbeat job timing (used from Phase 7)
HEARTBEAT_INTERVAL=
RED_AFTER_RUNS=
AI_REVIEW_EVERY_RUNS=

# AI review (Phase 7). Leave empty to run without it.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# GitHub OAuth (Phase 6)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Check adapters: mock or a provider name
KYC_MODE=mock
SOCIAL_MODE=mock
