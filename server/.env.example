# Copy to server/.env and fill in. server/.env is git-ignored: never commit real values.

PORT=8787
HOST=127.0.0.1

# Solana (devnet only; never put a mainnet URL here)
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=9dCBaMA4rwxAhnAh9mKbmr27FTakFVZ2KdcbyjyZpm7j
# Path to the backend signing key. The file itself must stay out of git.
OPERATOR_KEYPAIR_PATH=
# Comma-separated admin wallet addresses
ADMIN_WALLETS=

# Storage and sessions
DATABASE_URL=file:./prisma/dev.db
SESSION_SECRET=

# Heartbeat job timing. Devnet defaults: a run every 60 seconds, Red after 2 failing runs,
# an AI review every 5 runs. Production: 86400 (daily), 7, 7.
HEARTBEAT_INTERVAL=60
RED_AFTER_RUNS=2
AI_REVIEW_EVERY_RUNS=5

# AI review. Leave AI_API_KEY empty to run without it. Provider: gemini.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# GitHub OAuth (Phase 6)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where the frontend runs (GitHub sign-in redirects back here)
APP_URL=http://localhost:5173

# Check adapters: mock or a provider name
KYC_MODE=mock
SOCIAL_MODE=mock
# The domain check is real by default (DNS TXT record + HTTPS). `mock` is for scripted demos only.
DOMAIN_MODE=real
