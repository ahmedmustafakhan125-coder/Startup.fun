# Copy to app/.env.local to override. Mock mode needs none of these.

# mock = bundled demo data (default). live = devnet program + API (from Phase 5).
VITE_DATA_SOURCE=mock

# Used in live mode only. Devnet only; never put a mainnet URL here.
VITE_API_URL=http://localhost:8787
VITE_RPC_URL=https://api.devnet.solana.com
VITE_PROGRAM_ID=
