# Copy to app/.env.local to override. Mock mode needs none of these.

# mock = bundled demo data (default). live = the devnet program, with a real wallet such as Phantom set to devnet.
VITE_DATA_SOURCE=mock

# Used in live mode only. Devnet only; never put a mainnet URL here.
# The dev server forwards /api to the backend at VITE_API_PROXY (server/.env PORT).
VITE_API_URL=/api
VITE_API_PROXY=http://127.0.0.1:8787
VITE_RPC_URL=https://api.devnet.solana.com
VITE_PROGRAM_ID=9dCBaMA4rwxAhnAh9mKbmr27FTakFVZ2KdcbyjyZpm7j
